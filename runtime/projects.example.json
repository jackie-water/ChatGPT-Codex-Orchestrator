{
  "projects": {
    "example-project": {
      "repository": "owner/repository",
      "default_branch": "main",
      "checkpoint_branch": "codex/checkpoints",
      "local_path_key": "example-project",
      "allowed_validation_executables": [
        "git",
        "node",
        "npm"
      ],
      "default_validation_steps": [
        {
          "name": "tests",
          "command": "npm",
          "arguments": [
            "test"
          ]
        },
        {
          "name": "lint",
          "command": "npm",
          "arguments": [
            "run",
            "lint"
          ]
        },
        {
          "name": "build",
          "command": "npm",
          "arguments": [
            "run",
            "build"
          ]
        }
      ],
      "prompt_limits": {
        "initial_max_chars": 12000,
        "revise_max_chars": 6000
      },
      "enforce_wrapper_validation": true,
      "max_iterations": 5,
      "code_review": {
        "enabled": true,
        "required_for_code_changes": true,
        "review_model": "gpt-5.6-luna",
        "review_reasoning": "medium",
        "docs_only_skip": true
      },
      "enabled": true
    }
  }
}
